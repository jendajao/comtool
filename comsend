#!/usr/bin/env python3
"""送指令到 comd 並印出回應。

usage: comsend [--raw] COMx "指令" [等待秒數，預設 1]
  預設會在指令後加 CR；--raw 則原樣送出，並解析 \\xNN 等跳脫字元（例如 '\\x0c'、'\\x11'）。
  連線埠預設為 7000+N，可用環境變數 COMSEND_PORT 覆寫。
"""
import os, re, socket, sys, time

args = sys.argv[1:]
raw = False
if args and args[0] == "--raw":
    raw, args = True, args[1:]
if len(args) < 2:
    sys.exit(__doc__)

com, text = args[0].upper(), args[1]
wait = float(args[2]) if len(args) > 2 else 1.0
m = re.fullmatch(r"COM(\d+)", com)
if not m:
    sys.exit("COM port 名稱錯誤: " + args[0])
port = int(os.environ.get("COMSEND_PORT", 7000 + int(m.group(1))))

if raw:
    payload = text.encode("latin1", "backslashreplace").decode("unicode_escape").encode("latin1")
else:
    payload = text.encode() + b"\r"

try:
    s = socket.create_connection(("127.0.0.1", port), timeout=3)
except OSError as e:
    sys.exit(f"無法連到 {com} (127.0.0.1:{port})，comd 有在執行嗎？ {e}")
s.sendall(payload)

buf = bytearray()
end = time.monotonic() + wait
while (left := end - time.monotonic()) > 0:
    s.settimeout(left)
    try:
        d = s.recv(4096)
    except socket.timeout:
        break
    if not d:
        break
    buf += d
s.close()


def strip_telnet(data):
    """濾掉 comd 送來的 telnet 協商序列，IAC IAC 還原成 0xFF。"""
    out, i, n = bytearray(), 0, len(data)
    while i < n:
        b = data[i]
        if b != 0xFF:
            out.append(b); i += 1
        elif i + 1 < n and data[i + 1] == 0xFF:
            out.append(0xFF); i += 2
        elif i + 1 < n and data[i + 1] in (251, 252, 253, 254):  # WILL/WONT/DO/DONT opt
            i += 3
        elif i + 1 < n and data[i + 1] == 250:                    # SB ... IAC SE
            j = data.find(b"\xff\xf0", i + 2)
            i = n if j < 0 else j + 2
        else:
            i += 2
    return bytes(out)


sys.stdout.write(strip_telnet(bytes(buf)).decode(errors="replace").replace("\r", ""))
sys.stdout.flush()
